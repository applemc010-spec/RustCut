{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustCut",
  "version": "0.1.0",
  "identifier": "com.rustcut.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RustCut",
        "width": 1500,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["bin/*"]
  }
}
